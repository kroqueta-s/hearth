# hearth configuration. Copy to .env; install.ps1 does that for you.
# **Keep the same set of keys as .env.** Absolute paths only: the processes
# involved have different working directories.

# --- hearth itself -----------------------------------------------------------
# Where results go. One directory per run, named by date and time.
HEARTH_OUTPUT_DIR=__ROOT__\output

# The python that runs hearth. **It does not need torch**: httpx, Pillow and
# python-dotenv are the whole of it.
HEARTH_PYTHON=__ROOT__\.venv\Scripts\python.exe

# --- Image generation (optional) ---------------------------------------------
# ComfyUI is a separate application, reached over HTTP only. **Nothing is ever
# installed into its virtual environment.** Leave this alone if you only use
# image_to_mesh with images you already have.
HEARTH_COMFY_BASE_URL=http://127.0.0.1:8200
HEARTH_WORKFLOW_DIR=hearth\workflows
HEARTH_COMFY_TIMEOUT_SEC=1800

# ControlNet weights, as ComfyUI names them. Only needed for sketch_to_image.
HEARTH_CONTROLNET_MODEL=

# --- Image models (**never name a model in code**; this file is the authority) -
# List only what is installed in ComfyUI. Leave a route empty when the model has
# none: asking for it then fails with a reason instead of quietly using
# something else.
HEARTH_IMAGE_MODELS=sdxl
HEARTH_IMAGE_MODEL=sdxl

HEARTH_IMAGE_MODEL_SDXL_CHECKPOINT=sd_xl_base_1.0.safetensors
HEARTH_IMAGE_MODEL_SDXL_TXT2IMG=sdxl_txt2img.json
HEARTH_IMAGE_MODEL_SDXL_IMG2IMG=sdxl_img2img.json
HEARTH_IMAGE_MODEL_SDXL_CONTROLNET=sdxl_controlnet.json

# FLUX.1 [dev] fp8, a single checkpoint. **The weights are non-commercial.**
# Add `flux` to HEARTH_IMAGE_MODELS above to enable it. It has no ControlNet:
# that needs a separate FLUX-specific model.
HEARTH_IMAGE_MODEL_FLUX_CHECKPOINT=flux1-dev-fp8.safetensors
HEARTH_IMAGE_MODEL_FLUX_TXT2IMG=flux_txt2img.json
HEARTH_IMAGE_MODEL_FLUX_IMG2IMG=flux_img2img.json
HEARTH_IMAGE_MODEL_FLUX_CONTROLNET=

# Unload the 3D model before generating an image. ComfyUI and a 3D runner share
# one card, and going over it does not fail: it falls back to shared memory and
# runs several times slower **without saying anything**. Turning this off is a
# measurement, not a hope. The cost of leaving it on is a reload afterwards,
# which is a number you can see.
HEARTH_FREE_MESH_BEFORE_IMAGE=1

# --- Starting ComfyUI ---------------------------------------------------------
# **hearth starts ComfyUI as a child process** and stops only the one it
# started: one that is already listening is adopted and left alone. Its virtual
# environment is never touched and its code is never modified - the command line
# below is the only lever, and it is the one that matters, because **the launch
# arguments decide whether a model fits on the card**.
#
# Leave PYTHON and ROOT empty to keep the old behaviour: hearth then only ever
# adopts a ComfyUI somebody else started.
HEARTH_COMFY_PYTHON=
HEARTH_COMFY_ROOT=

# Extra arguments, split like a shell would. **Which ones a card needs is a
# measurement, not a default.** On the machine this was written for (a
# gfx1151 iGPU with 32 GB carved out as dedicated VRAM), FLUX needed all three:
#
#   --bf16-text-enc      the text encoder in bf16
#   --fp8_e4m3fn-unet    keep an fp8 checkpoint in fp8. Without it, a GPU with
#                        no fp8 arithmetic expands the weights to bf16: measured
#                        2026-09-06, ComfyUI reported loading 22,700 MB with it
#                        off and 11,350 MB with it on
#   --reserve-vram <GB>  hide the shared pool from ComfyUI, so it stops loading
#                        when the *card* is full rather than when the card plus
#                        system RAM is
HEARTH_COMFY_ARGS=

# Start ComfyUI when hearth starts. Off by default: a caller that only makes
# meshes should not pay for weights it will never use.
HEARTH_COMFY_AUTOSTART=0

# How long to wait for /system_stats to answer. The first run after a custom
# node changes is noticeably slower.
HEARTH_COMFY_START_TIMEOUT_SEC=300

# --- Watching the card --------------------------------------------------------
# **What the card really has**, in GB. Every figure a GPU library reports
# includes the shared pool - system RAM the driver spills into - so it is larger
# than the card and an application that believes it loads until it is paging.
# 0 means "report what is in use and claim no total".
HEARTH_VRAM_DEDICATED_GB=0

# How much shared (system) memory one process may use before its work is
# abandoned. **Going over the card does not fail, it gets several times
# slower**, so waiting for it costs more than starting again with less. 0
# disables it.
HEARTH_VRAM_SHARED_ABORT_GB=1.0

# How often the GPU counters are read, in seconds. Reading them is cheap; this
# only decides how stale the number in `status` may be.
HEARTH_VRAM_SAMPLE_SEC=2

# How much VRAM every process together can hold, in GB, before the driver has to
# choose between spilling and failing a runner's command submit - **measure it
# on your card**: hold a large block in another process and watch dedicated
# usage stop rising. A generation whose runner declares `vram_peak_gb` is not
# started while other processes and that figure exceed this; it waits up to
# HEARTH_VRAM_HEADROOM_WAIT_SEC for memory to come back, then answers
# `VramShortError` naming who holds it. 0 falls back to HEARTH_VRAM_DEDICATED_GB,
# and 0 there too turns the check off.
HEARTH_VRAM_USABLE_GB=0
HEARTH_VRAM_HEADROOM_WAIT_SEC=15

# --- Keeping the GPU to ourselves --------------------------------------------
# A port that, when something is listening on it, means **another application**
# already holds the GPU. hearth then refuses to load a runner rather than letting
# both fight over VRAM and slow each other to a crawl. **0 disables the check.**
HEARTH_GPU_BUSY_PORT=0

# A port hearth listens on **itself** while a model is loaded, so a second hearth
# (another editor window, or a command line run beside one) finds the first
# instead of quietly loading a second model into the same card. **Not the same
# port as above**: that one belongs to somebody else. 0 disables it, and then
# nothing detects that case. Pick any free port.
HEARTH_LOCK_PORT=8011

# --- Runners (**never name a model in code**; this file is the authority) -----
# One entry per installed runner, written by `install.ps1 -Runner <name>=<path>`
# or by `tools/add_runner.ps1`.
#
# CWD points at the runner's own repository, which carries its own .env with the
# paths to its weights. MODULE is the package inside that repository.
#
# **A runner does not have to generate.** partfield below answers `segment_mesh`
# (contract §5a) and declares `image_to_mesh: false`; it is registered exactly
# like any other, because nothing here knows what a runner is for.
#
#   HEARTH_RUNNERS=hunyuan3d,partfield
#   HEARTH_RUNNER_PARTFIELD_PYTHON=C:\path\to\partfield\.venv\Scripts\python.exe
#   HEARTH_RUNNER_PARTFIELD_MODULE=runners.partfield
#   HEARTH_RUNNER_PARTFIELD_CWD=C:\path\to\partfield-runner
HEARTH_RUNNERS=
